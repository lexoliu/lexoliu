diff --git a/tests/manual/sb16-ring.asm b/tests/manual/sb16-ring.asm
new file mode 100644
index 00000000..1881d4ba
--- /dev/null
+++ b/tests/manual/sb16-ring.asm
@@ -0,0 +1,142 @@
+; Boot sector: SB16 8-bit auto-init DMA playback from a two-half ring.
+; Every byte of a half holds that half's sequence number. The IRQ handler
+; refills the half that just finished with the next sequence number and
+; writes that number to COM1, so the host can check that the DAC output is
+; 0, 1, 2, 3, ... with no half played twice.
+
+bits 16
+org 0x7C00
+
+HALF        equ 2048            ; bytes per ring half (one SB16 block)
+RING_SEG    equ 0x1000          ; ring at physical 0x10000 (DMA page 1)
+SB          equ 0x220
+COM1        equ 0x3F8
+
+start:
+    cli
+    xor ax, ax
+    mov ds, ax
+    mov ss, ax
+    mov sp, 0x7C00
+    mov word [0x0D * 4], isr    ; IRQ 5 -> vector 0x0D
+    mov word [0x0D * 4 + 2], ax
+
+    mov ax, RING_SEG
+    mov es, ax
+    xor di, di
+    mov cx, HALF
+    xor al, al
+    rep stosb                   ; half 0 = seq 0
+    mov cx, HALF
+    inc al
+    rep stosb                   ; half 1 = seq 1
+
+    ; DSP reset
+    mov dx, SB + 6
+    mov al, 1
+    out dx, al
+    in al, dx
+    in al, dx
+    xor al, al
+    out dx, al
+    mov dx, SB + 0xE
+.wait_reset:
+    in al, dx
+    test al, 0x80
+    jz .wait_reset
+    mov dx, SB + 0xA
+    in al, dx
+    cmp al, 0xAA
+    jne fail
+
+    ; DMA channel 1: single mode, auto-init, memory -> device
+    mov al, 0x05
+    out 0x0A, al                ; mask
+    out 0x0C, al                ; clear flip-flop
+    mov al, 0x59
+    out 0x0B, al
+    xor al, al
+    out 0x02, al                ; address 0x0000
+    out 0x02, al
+    mov al, 0x01
+    out 0x83, al                ; page 1
+    mov al, (2 * HALF - 1) & 0xFF
+    out 0x03, al
+    mov al, (2 * HALF - 1) >> 8
+    out 0x03, al
+    mov al, 0x01
+    out 0x0A, al                ; unmask
+
+    in al, 0x21
+    and al, ~0x20
+    out 0x21, al                ; unmask IRQ 5
+
+    mov si, dsp_init
+    mov cx, dsp_init_len
+.dsp:
+    lodsb
+    call dsp_write
+    loop .dsp
+
+    sti
+.idle:
+    hlt
+    jmp .idle
+
+fail:
+    mov dx, COM1
+    mov al, 0xFF
+    out dx, al
+    cli
+    hlt
+
+dsp_write:
+    mov dx, SB + 0xC
+    mov ah, al
+.busy:
+    in al, dx
+    test al, 0x80
+    jnz .busy
+    mov al, ah
+    out dx, al
+    ret
+
+isr:
+    push ax
+    push cx
+    push dx
+    push di
+    push es
+    mov dx, SB + 0xE
+    in al, dx                   ; acknowledge 8-bit IRQ
+    mov ax, RING_SEG
+    mov es, ax
+    mov di, [cs:next_half]
+    xor word [cs:next_half], HALF
+    inc byte [cs:seq]
+    mov al, [cs:seq]
+    mov cx, HALF
+    rep stosb
+    mov dx, COM1
+    out dx, al
+    mov al, 0x20
+    out 0x20, al
+    pop es
+    pop di
+    pop dx
+    pop cx
+    pop ax
+    iret
+
+next_half:  dw 0
+seq:        db 1
+
+dsp_init:
+    db 0x41, 22050 >> 8, 22050 & 0xFF  ; output rate
+    db 0xD1                            ; speaker on
+    db 0xC6, 0x00                      ; 8-bit auto-init output, mono unsigned
+    db (HALF - 1) & 0xFF, (HALF - 1) >> 8
+dsp_init_len equ $ - dsp_init
+
+    times 510 - ($ - $$) db 0
+    dw 0xAA55
diff --git a/tests/manual/sb16-stall.html b/tests/manual/sb16-stall.html
new file mode 100644
index 00000000..9facd5ef
--- /dev/null
+++ b/tests/manual/sb16-stall.html
@@ -0,0 +1,82 @@
+<!doctype html>
+<title>Test that SB16 DMA does not replay audio after the main thread stalls</title>
+
+<!--
+Build the guest first: nasm -f bin -o build/sb16-ring.bin tests/manual/sb16-ring.asm
+
+The guest plays an auto-init DMA ring whose halves hold increasing sequence
+numbers. After two seconds this page blocks the main thread for 300 ms, then
+checks that the buffers sent to the speaker carried each half exactly once.
+-->
+
+<script src="../../build/libv86.js"></script>
+<script>
+"use strict";
+
+const STALL_MS = 300;
+
+// Record every buffer the speaker sends to the DAC worklet.
+const halves = [];
+const post_message = MessagePort.prototype.postMessage;
+MessagePort.prototype.postMessage = function(message, transfer)
+{
+    if(message && message.type === "queue")
+    {
+        const samples = message.value[0];
+        for(let i = 0; i < samples.length; i++)
+        {
+            const value = Math.round((samples[i] + 1) * 127.5);
+            if(halves[halves.length - 1] !== value) halves.push(value);
+        }
+    }
+    return post_message.call(this, message, transfer);
+};
+
+function report(text)
+{
+    console.log(text);
+    document.getElementById("result").textContent = text;
+}
+
+window.onload = async function()
+{
+    const sector = await (await fetch("../../build/sb16-ring.bin")).arrayBuffer();
+    const fda = new Uint8Array(1474560);
+    fda.set(new Uint8Array(sector));
+
+    const emulator = new V86({
+        wasm_path: "../../build/v86.wasm",
+        memory_size: 32 * 1024 * 1024,
+        screen_container: document.getElementById("screen_container"),
+        bios: { url: "../../bios/seabios.bin" },
+        vga_bios: { url: "../../bios/vgabios.bin" },
+        fda: { buffer: fda.buffer },
+        autostart: true,
+    });
+
+    setTimeout(() => {
+        const start = performance.now();
+        while(performance.now() - start < STALL_MS);
+
+        setTimeout(() => {
+            emulator.destroy();
+            const replayed = [];
+            for(let i = 1; i < halves.length; i++)
+            {
+                if((halves[i] - halves[i - 1] & 0xFF) !== 1) replayed.push(halves[i - 1] + " -> " + halves[i]);
+            }
+            if(halves.length < 20) report("FAIL: only " + halves.length + " halves played (is audio allowed to start?)");
+            else if(replayed.length) report("FAIL: halves out of order: " + replayed.join(", "));
+            else report("PASS: " + halves.length + " halves played once each");
+        }, 1500);
+    }, 2000);
+};
+</script>
+
+<p id="result">Running ...</p>
+
+<!-- A minimal structure for the ScreenAdapter defined in browser/screen.js -->
+<div id="screen_container">
+    <div style="white-space: pre; font: 14px monospace; line-height: 14px"></div>
+    <canvas style="display: none"></canvas>
+</div>
